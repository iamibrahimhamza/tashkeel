# ── Core ─────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://tashkeel:tashkeel@localhost:5432/tashkeel?schema=public
REDIS_URL=redis://localhost:6379

# ── URLs ─────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public domain; expert homes are clean paths on it (tashkeel.online/<slug>)
NEXT_PUBLIC_ROOT_DOMAIN=tashkeel.online

# ── Auth (shared between web session and API JWT verification) ─
# generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Tashkeel Pay / Stripe (test mode keys only in dev) ─
# Empty or "mock" → local Sandbox gateway (no real money, same pipeline).
# Real keys (sk_test_… / sk_live_…) → Stripe. See README → "Connecting Stripe".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Web app (optional with hosted Checkout; reserved for embedded Stripe Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AES-256-GCM key for payout details, base64 of 32 bytes: openssl rand -base64 32
PAYOUT_ENCRYPTION_KEY=
# HMAC secret alternative payout rails use to sign status callbacks
PAYOUT_WEBHOOK_SECRET=
# Days earnings stay pending (refund window) before becoming withdrawable
FUNDS_HOLD_DAYS=7

# ── Background jobs ──────────────────────────────────
# inline = in-process (no Redis needed); bullmq = Redis + `pnpm --filter @tashkeel/api worker`
QUEUE_DRIVER=inline

# ── Storage (MinIO locally, R2/S3 in prod) ───────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tashkeel-private
S3_ACCESS_KEY_ID=tashkeel
S3_SECRET_ACCESS_KEY=tashkeel-secret

# ── Video ────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ── Email ────────────────────────────────────────────
SMTP_URL=smtp://localhost:1025
# Optional; defaults to "Tashkeel <no-reply@$NEXT_PUBLIC_ROOT_DOMAIN>"
EMAIL_FROM=

# ── Founder account (seed) ───────────────────────────
# Seeds one SUPERADMIN who owns the empty "/ibrahim" workspace. Leave the password empty
# to have the seed generate one and print it once.
FOUNDER_EMAIL=
FOUNDER_PASSWORD=
FOUNDER_TIMEZONE=Asia/Riyadh
