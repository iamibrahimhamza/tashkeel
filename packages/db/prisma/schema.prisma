// Tashkeel (تشكيل) — relational schema.
// Conventions:
//  * Money is stored as BigInt minor units next to an ISO-4217 `currency`.
//  * All timestamps are UTC (timestamptz). Local wall-clock times use "HH:mm" strings + IANA tz.
//  * Every expert-owned row carries `workspaceId` (tenant key).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, citext]
}

// ───────────────────────── Identity & RBAC ─────────────────────────

enum PlatformRole {
  USER
  STAFF
  SUPERADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  SUPPORT
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique @db.Citext
  emailVerified DateTime?    @db.Timestamptz(3)
  passwordHash  String?
  name          String?
  image         String?
  locale        String       @default("ar")
  timezone      String       @default("Asia/Riyadh")
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  orders         Order[]           @relation("CustomerOrders")
  bookings       Booking[]         @relation("CustomerBookings")
  entitlements   Entitlement[]
  lessonProgress LessonProgress[]
  pageVersions   PageVersion[]
  posts          Post[]            @relation("PostAuthor")
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique @db.Citext
  name      String
  country   String? // ISO-3166 alpha-2, drives payout rails
  timezone  String   @default("Asia/Riyadh")
  currency  String   @default("USD")
  planCode  PlanCode @default(FREE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships     Membership[]
  site            Site?
  services        Service[]
  availability    AvailabilityRule[]
  overrides       AvailabilityOverride[]
  bookings        Booking[]
  products        Product[]
  posts           Post[]
  tags            Tag[]
  subscribers     Subscriber[]
  orders          Order[]
  subscription    Subscription?
  ledgerAccounts  LedgerAccount[]
  payoutProfiles  PayoutProfile[]
  payouts         Payout[]
  contacts        Contact[]
  activities      ActivityEvent[]
  dailyMetrics    DailyMetric[]
  auditLogs       AuditLog[]
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ───────────────────────── Module A — Digital Home ─────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model Theme {
  id        String  @id // e.g. "editorial-sand", "editorial-forest"
  name      String
  nameAr    String
  tokens    Json // validated by @tashkeel/contracts ThemeTokens
  isDefault Boolean @default(false)
  sites     Site[]
}

model Site {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  themeId        String
  themeOverrides Json      @default("{}")
  seo            Json      @default("{}")
  customDomain   String?   @unique @db.Citext
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  theme          Theme     @relation(fields: [themeId], references: [id])
  pages          Page[]
}

model Page {
  id                 String        @id @default(cuid())
  siteId             String
  path               String // "/" for the home page
  title              String
  status             PublishStatus @default(DRAFT)
  publishedVersionId String?       @unique
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  site               Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  versions           PageVersion[] @relation("PageVersions")
  publishedVersion   PageVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  @@unique([siteId, path])
}

/// Immutable snapshot of a page's blocks. Publishing swaps Page.publishedVersionId.
model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  blocks      Json // validated by @tashkeel/contracts PageBlocks
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  page        Page     @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedOf Page?    @relation("PublishedVersion")
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([pageId, createdAt])
}

// ───────────────────────── Module B — Consultations ─────────────────────────

enum LocationType {
  VIDEO
  IN_PERSON
  PHONE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Service {
  id             String       @id @default(cuid())
  workspaceId    String
  title          String
  description    String?
  durationMin    Int
  bufferBeforeMin Int         @default(0)
  bufferAfterMin Int          @default(0)
  priceMinor     BigInt
  currency       String       @default("USD")
  locationType   LocationType @default(VIDEO)
  minNoticeMin   Int          @default(720)
  maxAdvanceDays Int          @default(60)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  orderItems     OrderItem[]

  @@index([workspaceId])
}

/// Weekly recurring availability in the expert's local wall-clock time.
model AvailabilityRule {
  id          String    @id @default(cuid())
  workspaceId String
  timezone    String // IANA, e.g. "Asia/Damascus"
  weekday     Int // 0=Sunday … 6=Saturday
  startLocal  String // "09:00"
  endLocal    String // "17:00"
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, weekday])
}

/// Date-specific exception: either a full day off (no windows) or replacement windows.
model AvailabilityOverride {
  id          String    @id @default(cuid())
  workspaceId String
  date        String // "2026-10-20" in the expert's timezone
  windows     Json      @default("[]") // [{ startLocal, endLocal }]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}

/// Double-booking is prevented by an exclusion constraint added in a SQL migration:
///   EXCLUDE USING gist (workspaceId WITH =, tstzrange(blockStartsAt, blockEndsAt) WITH &&)
///   WHERE (status IN ('PENDING_PAYMENT','CONFIRMED'))
model Booking {
  id            String        @id @default(cuid())
  workspaceId   String
  serviceId     String
  customerId    String
  startsAt      DateTime      @db.Timestamptz(3)
  endsAt        DateTime      @db.Timestamptz(3)
  blockStartsAt DateTime      @db.Timestamptz(3) // startsAt - bufferBefore
  blockEndsAt   DateTime      @db.Timestamptz(3) // endsAt + bufferAfter
  customerTz    String
  status        BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt DateTime?     @db.Timestamptz(3)
  meetingUrl    String?
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id])
  customer      User          @relation("CustomerBookings", fields: [customerId], references: [id])
  orderItem     OrderItem?

  @@index([workspaceId, startsAt])
  @@index([status, holdExpiresAt])
}

// ───────────────────────── Module C — Digital Assets & LMS ─────────────────────────

enum ProductType {
  FILE
  COURSE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  FILE
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  REFUNDED
}

model Product {
  id           String        @id @default(cuid())
  workspaceId  String
  type         ProductType
  slug         String
  title        String
  description  String?
  coverKey     String?
  priceMinor   BigInt
  currency     String        @default("USD")
  status       ProductStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files        ProductFile[]
  course       Course?
  entitlements Entitlement[]
  orderItems   OrderItem[]

  @@unique([workspaceId, slug])
}

model ProductFile {
  id         String          @id @default(cuid())
  productId  String
  storageKey String          @unique
  fileName   String
  sizeBytes  BigInt
  mime       String
  sha256     String?
  scanStatus String          @default("PENDING") // PENDING | CLEAN | INFECTED
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  grants     DownloadGrant[]
}

model Course {
  id        String         @id @default(cuid())
  productId String         @unique
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modules   CourseModule[]
}

model CourseModule {
  id       String   @id @default(cuid())
  courseId String
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id           String           @id @default(cuid())
  moduleId     String
  title        String
  position     Int
  type         LessonType
  videoAssetId String? // provider asset/playback id (Mux)
  durationSec  Int?
  contentMd    String?
  fileKey      String?
  isPreview    Boolean          @default(false)
  module       CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]

  @@unique([moduleId, position])
}

/// The single access gate for downloads and lessons.
model Entitlement {
  id          String            @id @default(cuid())
  userId      String
  productId   String
  orderItemId String?           @unique
  status      EntitlementStatus @default(ACTIVE)
  expiresAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?        @relation(fields: [orderItemId], references: [id])
  grants      DownloadGrant[]

  @@index([userId, productId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  positionSec Int       @default(0)
  completedAt DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model DownloadGrant {
  id            String      @id @default(cuid())
  entitlementId String
  fileId        String
  expiresAt     DateTime    @db.Timestamptz(3)
  ip            String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  file          ProductFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([entitlementId, createdAt])
}

// ───────────────────────── Module D — Editorial ─────────────────────────

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

model Post {
  id          String         @id @default(cuid())
  workspaceId String
  authorId    String
  slug        String
  title       String
  excerpt     String?
  bodyMd      String
  bodyHtml    String? // sanitized render cache
  coverKey    String?
  status      PostStatus     @default(DRAFT)
  publishAt   DateTime?      @db.Timestamptz(3)
  publishedAt DateTime?      @db.Timestamptz(3)
  seo         Json           @default("{}")
  readingMin  Int            @default(1)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User           @relation("PostAuthor", fields: [authorId], references: [id])
  tags        PostTag[]
  stats       PostStatDaily[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, publishedAt])
  @@index([status, publishAt])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts       PostTag[]

  @@unique([workspaceId, slug])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostStatDaily {
  postId  String
  date    DateTime @db.Date
  views   Int      @default(0)
  readers Int      @default(0)
  signups Int      @default(0)
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, date])
}

model Subscriber {
  id          String           @id @default(cuid())
  workspaceId String
  email       String           @db.Citext
  status      SubscriberStatus @default(PENDING)
  source      String? // e.g. "post:<slug>", "home"
  consentAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

// ───────────────────────── Module E — Tashkeel Pay ─────────────────────────

enum PlanCode {
  FREE
  PRO
  BUSINESS
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum LedgerOwner {
  WORKSPACE
  PLATFORM
}

enum LedgerAccountType {
  CUSTOMER_FUNDS // clearing account at the processor
  PROCESSOR_FEES // Stripe fees (platform expense)
  PLATFORM_REVENUE // Tashkeel transaction fees
  EXPERT_PENDING // earned, inside the hold window
  EXPERT_AVAILABLE // withdrawable
  PAYOUTS_IN_TRANSIT // requested / processing payouts
}

enum PayoutMethod {
  STRIPE_CONNECT
  AL_BARAKA
  SHAM_CASH
  WALLET
  BANK_WIRE
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Plan {
  code           PlanCode @id
  name           String
  nameAr         String
  monthlyMinor   BigInt
  currency       String   @default("USD")
  feeBps         Int // transaction fee in basis points (800 = 8%)
  feeFixedMinor  BigInt   @default(0)
  stripePriceId  String?
  features       Json     @default("{}")
}

model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  planCode             PlanCode
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  status               String // mirrors Stripe: active | past_due | canceled | trialing ...
  currentPeriodEnd     DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Order {
  id                      String      @id @default(cuid())
  workspaceId             String
  customerId              String
  status                  OrderStatus @default(PENDING)
  currency                String
  subtotalMinor           BigInt
  platformFeeMinor        BigInt // computed at checkout from the plan snapshot
  processorFeeMinor       BigInt      @default(0) // known after payment
  netMinor                BigInt      @default(0) // known after payment
  refundedMinor           BigInt      @default(0)
  feeBpsSnapshot          Int
  feeFixedSnapshot        BigInt
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  paidAt                  DateTime?   @db.Timestamptz(3)
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(3)
  workspace               Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer                User        @relation("CustomerOrders", fields: [customerId], references: [id])
  items                   OrderItem[]

  @@index([workspaceId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  productId      String?
  serviceId      String?
  bookingId      String?      @unique
  title          String // snapshot
  unitPriceMinor BigInt
  quantity       Int          @default(1)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id])
  service        Service?     @relation(fields: [serviceId], references: [id])
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  entitlement    Entitlement?
}

model LedgerAccount {
  id          String            @id @default(cuid())
  owner       LedgerOwner
  workspaceId String?
  type        LedgerAccountType
  currency    String
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]

  // NULL workspaceId (platform accounts) is made unique via a partial index in SQL migration.
  @@unique([owner, workspaceId, type, currency])
}

/// One balanced journal entry. (kind, refId) is unique, so re-posting the same business
/// event (e.g. a redelivered webhook) is a no-op enforced by the database.
model LedgerTransaction {
  id        String        @id @default(cuid())
  kind      String // ORDER_PAID | FUNDS_RELEASED | REFUND | PAYOUT_REQUESTED | PAYOUT_PAID | PAYOUT_FAILED | DISPUTE
  refType   String
  refId     String
  memo      String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  entries   LedgerEntry[]

  @@unique([kind, refId])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  accountId     String
  amountMinor   BigInt // signed: + debit, − credit; per transaction sums to 0
  availableAt   DateTime?         @db.Timestamptz(3) // for EXPERT_PENDING: when it can be released
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
}

model PayoutProfile {
  id               String       @id @default(cuid())
  workspaceId      String
  method           PayoutMethod
  label            String
  maskedHint       String // e.g. "•••• 4821" — safe to display
  detailsEncrypted String // AES-256-GCM, never returned in plaintext by the API
  stripeAccountId  String?
  isDefault        Boolean      @default(false)
  verifiedAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payouts          Payout[]

  @@index([workspaceId])
}

model Payout {
  id             String        @id @default(cuid())
  workspaceId    String
  profileId      String
  amountMinor    BigInt
  currency       String
  method         PayoutMethod
  status         PayoutStatus  @default(REQUESTED)
  providerRef    String?
  receiptKey     String?
  failureReason  String?
  idempotencyKey String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  profile        PayoutProfile @relation(fields: [profileId], references: [id])
  events         PayoutEvent[]

  @@unique([workspaceId, idempotencyKey])
  @@index([status, createdAt])
}

model PayoutEvent {
  id        String       @id @default(cuid())
  payoutId  String
  from      PayoutStatus?
  to        PayoutStatus
  actorId   String? // staff user for manual-ops transitions
  note      String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  payout    Payout       @relation(fields: [payoutId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Idempotency & Webhooks ─────────────────────────

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum IdempotencyState {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String // "stripe" | "payout:<method>"
  eventId     String
  type        String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  lastError   String?
  receivedAt  DateTime      @default(now()) @db.Timestamptz(3)
  processedAt DateTime?     @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

/// Claimed with a single INSERT; the unique constraint picks the winner among concurrent retries.
model IdempotencyKey {
  id           String           @id @default(cuid())
  scope        String // "<userId|ip>:<route>"
  key          String
  requestHash  String
  state        IdempotencyState @default(IN_PROGRESS)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime         @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

// ───────────────────────── Module F — CRM & Analytics ─────────────────────────

model Contact {
  id                 String          @id @default(cuid())
  workspaceId        String
  userId             String?
  email              String          @db.Citext
  name               String?
  phone              String?
  country            String?
  tags               String[]        @default([])
  source             String?
  lifetimeValueMinor BigInt          @default(0)
  firstSeenAt        DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt         DateTime        @default(now()) @db.Timestamptz(3)
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes              ContactNote[]
  activities         ActivityEvent[]

  @@unique([workspaceId, email])
  @@index([workspaceId, lastSeenAt])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  authorId  String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String?
  type        String // ORDER_PAID | BOOKING_CONFIRMED | ENROLLED | SUBSCRIBED | REFUNDED ...
  refId       String?
  data        Json      @default("{}")
  at          DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([type, refId])
  @@index([workspaceId, at])
  @@index([contactId, at])
}

model DailyMetric {
  workspaceId String
  date        DateTime  @db.Date
  metric      String // revenue_minor:USD | bookings | enrollments | downloads | subscribers | page_views
  value       BigInt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, date, metric])
}

// ───────────────────────── Platform ─────────────────────────

model AuditLog {
  id          String     @id @default(cuid())
  actorId     String?
  workspaceId String?
  action      String
  target      String?
  ip          String?
  data        Json       @default("{}")
  at          DateTime   @default(now()) @db.Timestamptz(3)
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, at])
}

/// Transactional outbox: written in the same DB transaction as the business change,
/// relayed to the email provider by the worker.
model EmailOutbox {
  id         String    @id @default(cuid())
  dedupeKey  String    @unique
  to         String
  template   String
  locale     String    @default("ar")
  data       Json
  sentAt     DateTime? @db.Timestamptz(3)
  attempts   Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([sentAt, createdAt])
}
